// Determinism rules for packages/engine/src that Biome has no stable rule for (ADR 0003 P5, plan
// §I.1). biome.json registers this plugin for that directory only; tests/repo/lint.test.ts proves
// that each pattern rejects its fixture. Binding `Object` to a name is rejected, but the patterns
// still see direct references only, so indirection such as `(Object as typeof Object).keys(x)`,
// `(Object).keys(x)`, or `({ constructor } = f)` is not caught.
language js

or {
  or {
    `$base ** $exponent`,
    // GritQL in Biome 2.6 cannot parse compound-assignment snippets, so `**=` is found as the text
    // between the assignment target and the right-hand side.
    JsAssignmentExpression(left=$target) as $assignment where {
      $assignment <: r"(?s)^(.*?)\s*\*\*=.*"($before),
      $before <: $target
    }
  } as $match where {
    register_diagnostic(span=$match, message="`**` and `**=` are implementation-approximated in ECMAScript, so engines may round them differently: multiply integers explicitly (determinism, ADR 0003, plan §I.1).")
  },
  or {
    JsFunctionDeclaration(),
    JsFunctionExportDefaultDeclaration(),
    JsFunctionExpression(),
    JsArrowFunctionExpression(),
    JsMethodClassMember(),
    JsMethodObjectMember()
  } as $match where {
    $match <: r"(?s)^(?:(?:static|public|private|protected|override)\s+)*async\b.*",
    register_diagnostic(span=$match, message="The engine is synchronous: `async` functions return promises that settle outside the tick (determinism, ADR 0003, plan §I.1).")
  },
  or {
    JsAwaitExpression(),
    JsForOfStatement() as $loop where { $loop <: r"(?s)^for\s+await\b.*" }
  } as $match where {
    register_diagnostic(span=$match, message="The engine is synchronous: `await` and `for await` yield to the host's job queue (determinism, ADR 0003, plan §I.1).")
  },
  or {
    JsStaticMemberExpression(member=r"^(?:localeCompare|toLocale[A-Za-z]*)$"),
    JsComputedMemberExpression(member=r"^[\x22\x27\x60](?:localeCompare|toLocale[A-Za-z]*)[\x22\x27\x60]$")
  } as $match where {
    register_diagnostic(span=$match, message="Locale-sensitive methods depend on the host's locale data: compare and format code units explicitly (determinism, ADR 0003, plan §I.1).")
  },
  or {
    JsStaticMemberExpression(object=`Object`, member=r"^(?:keys|values|entries|getOwnProperty(?:Names|Symbols|Descriptors))$"),
    JsComputedMemberExpression(object=`Object`, member=r"^[\x22\x27\x60](?:keys|values|entries|getOwnProperty(?:Names|Symbols|Descriptors))[\x22\x27\x60]$")
  } as $match where {
    register_diagnostic(span=$match, message="Key enumeration through `Object` (`keys`, `values`, `entries`, `getOwnPropertyNames`, `getOwnPropertySymbols`, `getOwnPropertyDescriptors`) follows insertion order, which a resumed world may not share: iterate in canonical order (determinism, ADR 0003, plan §I.1).")
  },
  or {
    `$binding = Object`,
    JsAssignmentExpression(right=`Object`)
  } as $match where {
    register_diagnostic(span=$match, message="Binding `Object` to a name hides its key-enumeration members from this check: call `Object` members directly (determinism, ADR 0003, plan §I.1).")
  },
  or {
    JsStaticMemberExpression(member=r"^constructor$"),
    JsComputedMemberExpression(member=r"^[\x22\x27\x60]constructor[\x22\x27\x60]$")
  } as $match where {
    register_diagnostic(span=$match, message="`.constructor` reaches the `Function` constructor, which compiles strings into code like eval (ADR 0003 P5).")
  }
}
