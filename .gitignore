# Ignore only what this project and its tools produce, with patterns narrow enough that they never
# hide source files (a pattern such as `logs` or `*.seed` would also hide engine code and world
# seeds). Biome honors this file and .git/info/exclude but not git's global ignore file, so tool
# files that are usually ignored globally are listed here too.

# Dependencies
node_modules/

# Environment files: only the example is versioned (AGENTS.md, Secrets and safety)
.env
.env.*
!.env.example

# Build output, caches, logs and coverage reports
dist/
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*.log
/coverage/

# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local tools: Claude Code personal settings, CodeGraph index, gentle-ai state
.claude/settings.local.json
.codegraph/
.atl/
